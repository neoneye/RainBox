# Copy this file to `.env` (same directory) and fill in the values you need.
# `.env` is gitignored — it holds secrets and never belongs in a commit.
#
# It is loaded by source/env_file.py at provider import, so every process that
# builds an LLM sees it: the web app, main.py, the benchmark runners, and the
# /model test-worker subprocess. Variables already set in the environment win,
# so `OPENROUTER_API_KEY=… python main.py` still overrides the file.

# OpenRouter (https://openrouter.ai) — required to use any OpenRouter model.
# Create an account, buy credits, and generate a key under Keys.
# Without it, OpenRouter is reported as unconfigured: no rows change, and the
# Add-model overlay on /model says what's missing.
OPENROUTER_API_KEY=
