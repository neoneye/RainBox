# Copy this file to `.env` (same directory) and fill in the values you need.
# `.env` is gitignored — it holds secrets and never belongs in a commit.
#
# It is loaded by source/env_file.py at provider import, so every process that
# builds an LLM sees it: the web app, core.py, the benchmark runners, and the
# /model test-worker subprocess. Variables already set in the environment win,
# so `OPENROUTER_API_KEY=… python main.py` still overrides the file (the
# launcher passes its environment to core.py).

# OpenRouter (https://openrouter.ai) — required to use any OpenRouter model.
# Create an account, buy credits, and generate a key under Keys.
# Without it, OpenRouter is reported as unconfigured: no rows change, and the
# Add-model overlay on /model says what's missing.
OPENROUTER_API_KEY=

# Credentials that must NOT reach the core (a chat bridge's bot token, once
# bridges run under the launcher) do not belong here: this file is loaded by
# every process that builds an LLM. Put those in var/services/credentials.env
# (one NAME=value per line; owner-readable), which only main.py (the launcher) reads and
# hands to exactly the service that names it. See
# docs/superpowers/specs/2026-09-10-launcher-design.md.

# Seals chat-bridge credentials (Discord bot tokens) stored on /bridges.
# Any random string of 32+ characters, generated once; keep it with your
# backups — credentials sealed under it cannot be opened without it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RAINBOX_CREDENTIAL_KEY=
